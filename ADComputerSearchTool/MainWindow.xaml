<Window x:Class="ADComputerSearchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ADComputerSearchTool.Models"
        Title="AD-Computer-Suche"
        Icon="/Assets/ADComputerSearchTool.ico"
        Height="750"
        Width="1500"
        MinHeight="600"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Suchkriterien -->

        <GroupBox Grid.Row="0"
                  Header="Suchkriterien"
                  Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Computername -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Computername:"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Height="28"
                         Margin="0,0,18,8"
                         VerticalContentAlignment="Center"
                         Text="{Binding ComputerNameFilter,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- OU -->

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="OU enthält:"/>

                <TextBox Grid.Row="0"
                         Grid.Column="3"
                         Height="28"
                         Margin="0,0,18,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Beispiel: Controlling"
                         Text="{Binding OrganizationalUnitFilter,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Status -->

                <TextBlock Grid.Row="0"
                           Grid.Column="4"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Status:"/>

                <ComboBox Grid.Row="0"
                          Grid.Column="5"
                          Height="28"
                          Margin="0,0,0,8"
                          SelectedValue="{Binding SelectedStatus}"
                          SelectedValuePath="Tag">

                    <ComboBoxItem Content="Alle"
                                  Tag="{x:Static models:ComputerStatusFilter.All}"/>

                    <ComboBoxItem Content="Aktiv"
                                  Tag="{x:Static models:ComputerStatusFilter.Enabled}"/>

                    <ComboBoxItem Content="Deaktiviert"
                                  Tag="{x:Static models:ComputerStatusFilter.Disabled}"/>

                </ComboBox>

                <!-- Beschreibung -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Beschreibung:"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Height="28"
                         Margin="0,0,18,8"
                         VerticalContentAlignment="Center"
                         Text="{Binding DescriptionFilter,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Gruppenmitgliedschaft -->

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="Mitglied von:"/>

                <TextBox Grid.Row="1"
                         Grid.Column="3"
                         Height="28"
                         Margin="0,0,18,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Teil des Gruppennamens eingeben"
                         Text="{Binding GroupFilter,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- IP-Adresse -->

                <TextBlock Grid.Row="1"
                           Grid.Column="4"
                           Margin="0,0,8,8"
                           VerticalAlignment="Center"
                           Text="IPv4-Adresse:"/>

                <TextBox Grid.Row="1"
                         Grid.Column="5"
                         Height="28"
                         Margin="0,0,0,8"
                         VerticalContentAlignment="Center"
                         ToolTip="Beispiel: 192.168.145"
                         Text="{Binding IpAddressFilter,
                                        UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Schaltflächen -->

                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="6"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">

                    <Button Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="Zurücksetzen"
                            Command="{Binding ClearCommand}"/>

                    <Button Width="110"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="Suchen"
                            IsDefault="True"
                            Command="{Binding SearchCommand}"/>

                    <Button Width="140"
                            Height="32"
                            Content="Excel exportieren"
                            Command="{Binding ExportCommand}"/>

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- Statusbereich -->

        <Grid Grid.Row="1"
              Margin="0,10,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding StatusMessage}"/>

            <ProgressBar Grid.Column="1"
                         Width="220"
                         Height="16"
                         IsIndeterminate="True">

                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">

                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsBusy}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </ProgressBar.Style>

            </ProgressBar>

        </Grid>

        <!-- Ergebnistabelle -->

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Results}"
                  SelectedItem="{Binding SelectedComputer,
                                         Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  IsEnabled="{Binding IsNotBusy}"
                  AlternatingRowBackground="#F1F4F7"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  EnableRowVirtualization="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseRightButtonDown=
                      "ResultsGrid_PreviewMouseRightButtonDown">

            <DataGrid.ContextMenu>

                <ContextMenu>

                    <MenuItem Header="Zeile kopieren"
                              Click="CopyRowMenuItem_Click"/>

                    <MenuItem Header="Zelle kopieren"
                              Click="CopyCellMenuItem_Click"/>

                </ContextMenu>

            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Computer"
                                    Binding="{Binding Name}"
                                    Width="150"/>

                <DataGridTextColumn Header="IPv4-Adresse"
                                    Binding="{Binding IpAddress}"
                                    Width="125"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="95"/>

                <DataGridTextColumn Header="Beschreibung"
                                    Binding="{Binding Description}"
                                    Width="230"/>

                <DataGridTextColumn Header="OU"
                                    Binding="{Binding OrganizationalUnit}"
                                    Width="300"/>

                <DataGridTextColumn Header="Mitglied von"
                                    Binding="{Binding MemberOf}"
                                    Width="430"/>

                <DataGridTextColumn Header="Letzte Anmeldung"
                                    Binding="{Binding LastLogon,
                                              StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="150"/>

                <DataGridTextColumn Header="Betriebssystem"
                                    Binding="{Binding OperatingSystem}"
                                    Width="210"/>

                <DataGridTextColumn Header="DNS-Hostname"
                                    Binding="{Binding DnsHostName}"
                                    Width="260"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Statusleiste -->

        <StatusBar Grid.Row="3"
                   Margin="0,8,0,0">

            <StatusBarItem>

                <TextBlock Text="{Binding ResultCountText}"/>

            </StatusBarItem>

        </StatusBar>

    </Grid>

</Window>